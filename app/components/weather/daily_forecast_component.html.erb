<div class="grid grid-cols-7 divide-x divide-gray-50">
  <% days.each do |day| %>
    <div class="flex flex-col items-center py-5 gap-1">
      <span class="text-xs font-semibold text-gray-600"><%= day[:label] %></span>

      <div class="my-1 w-8 h-8 flex items-center justify-center">
        <%= helpers.weather_icon_svg(day[:code], size: "w-7 h-7") %>
      </div>

      <span class="text-sm font-bold text-gray-900"
            data-temperature-target="value"
            data-f="<%= day[:max] %>">
        <%= day[:max].round %>&deg;
      </span>
      <span class="text-xs text-gray-400"
            data-temperature-target="value"
            data-f="<%= day[:min] %>">
        <%= day[:min].round %>&deg;
      </span>
    </div>
  <% end %>
</div>
