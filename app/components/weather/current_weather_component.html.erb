<div class="px-6 py-4 flex items-start justify-between">
  <div class="flex items-center gap-3">
    <%= helpers.weather_icon_svg(@current["weather_code"], size: "w-14 h-14") %>

    <div class="flex items-start leading-none">
      <span class="text-7xl font-bold text-gray-900 tracking-tight"
            data-temperature-target="value"
            data-f="<%= @current["temperature_2m"] %>">
        <%= @current["temperature_2m"].round %>
      </span>

      <div class="flex flex-col mt-2 ml-1 gap-0.5">
        <span class="text-2xl text-gray-400 font-light">&deg;</span>

        <div class="flex items-center gap-1 text-xs">
          <button data-action="click->temperature#toggle"
                  data-temperature-unit-param="F"
                  data-temperature-target="unit"
                  data-unit="F"
                  class="text-gray-900 font-semibold hover:text-gray-600 transition-colors">F</button>

          <span class="text-gray-300">/</span>

          <button data-action="click->temperature#toggle"
                  data-temperature-unit-param="C"
                  data-temperature-target="unit"
                  data-unit="C"
                  class="text-gray-400 font-normal hover:text-gray-600 transition-colors">C</button>
        </div>
      </div>
    </div>
  </div>

  <div class="text-sm text-gray-500 text-right space-y-1 pt-1">
    <p>Humidity: <%= @current["relative_humidity_2m"] %>%</p>
    <p>Winds: <%= @current["wind_speed_10m"].round %> km/h</p>
  </div>
</div>
