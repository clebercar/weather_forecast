<div class="grid grid-cols-7 border-b border-gray-100">
  <% hours.each_with_index do |hour, i| %>
    <div class="flex flex-col items-center py-3 <%= i == 0 ? 'border-b-2 border-gray-900' : '' %>">
      <span class="text-sm font-semibold text-gray-800"
            data-temperature-target="value"
            data-f="<%= hour[:temp] %>">
        <%= hour[:temp].round %>&deg;
      </span>
      <span class="text-xs text-gray-400 mt-0.5"><%= hour[:label] %></span>
    </div>
  <% end %>
</div>
