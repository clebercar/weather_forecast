<div class="px-6 pt-6 pb-3">
  <h1 class="text-2xl font-bold text-gray-900"><%= @result.city %>, <%= @result.country %></h1>
  <p class="text-gray-400 text-sm mt-0.5"><%= datetime %> &bull; <%= condition %></p>

  <% if @result.cached %>
    <div class="inline-flex items-center gap-1 mt-1.5 text-xs text-gray-400">
      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"/>
        <polyline points="12 6 12 12 16 14"/>
      </svg>
      <span>Cached result</span>
    </div>
  <% end %>
</div>
