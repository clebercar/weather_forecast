<div class="w-full flex flex-col items-center" data-controller="temperature">
  <div class="w-full max-w-2xl mb-5">
    <%= render Weather::SearchFormComponent.new(url: weather_search_index_path, compact: true) %>
  </div>

  <div class="w-full max-w-2xl bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
    <% if @result %>
      <%= render Weather::WeatherHeaderComponent.new(result: @result) %>
      <%= render Weather::CurrentWeatherComponent.new(current: @result.current) %>
      <%= render Weather::WavyChartComponent.new(temperatures: @result.hourly["temperature_2m"].first(7)) %>
      <%= render Weather::HourlyForecastComponent.new(hourly: @result.hourly) %>
      <%= render Weather::DailyForecastComponent.new(daily: @result.daily) %>

    <% else %>
      <%# Header %>
      <div class="px-6 pt-6 pb-3">
        <% if @searched %>
          <p class="text-sm text-red-400 mb-1">Location not found. Please try another zip code.</p>
        <% end %>
        <h1 class="text-2xl font-bold text-gray-200">— , —</h1>
        <p class="text-gray-200 text-sm mt-0.5">— &bull; —</p>
      </div>

      <%# Current weather %>
      <div class="px-6 py-4 flex items-start justify-between">
        <div class="flex items-center gap-3">
          <div class="w-14 h-14 rounded-full bg-gray-100"></div>
          <span class="text-7xl font-bold text-gray-200 tracking-tight">—</span>
        </div>
        <div class="text-sm text-gray-200 text-right space-y-1 pt-1">
          <p>Humidity: —</p>
          <p>Winds: —</p>
        </div>
      </div>

      <%# Wavy chart placeholder %>
      <div class="h-16 bg-gray-50"></div>

      <%# Hourly %>
      <div class="grid grid-cols-7 border-b border-gray-100">
        <% 7.times do %>
          <div class="flex flex-col items-center py-3">
            <span class="text-sm font-semibold text-gray-200">—</span>
            <span class="text-xs text-gray-200 mt-0.5">—</span>
          </div>
        <% end %>
      </div>

      <%# Daily %>
      <div class="grid grid-cols-7 divide-x divide-gray-50">
        <% 7.times do %>
          <div class="flex flex-col items-center py-5 gap-1">
            <span class="text-xs font-semibold text-gray-200">—</span>
            <div class="my-1 w-7 h-7 rounded-full bg-gray-100"></div>
            <span class="text-sm font-bold text-gray-200">—</span>
            <span class="text-xs text-gray-200">—</span>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
