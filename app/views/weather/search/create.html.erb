<div class="w-full flex flex-col items-center">
  <%# Search again bar %>
  <div class="w-full max-w-2xl mb-5">
    <%= form_with url: weather_search_index_path, method: :post, class: "flex gap-2" do |f| %>
      <%= f.text_field :city,
            placeholder: "Search another zip code or city...",
            class: "flex-1 px-4 py-2.5 rounded-xl border border-gray-200 bg-white shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-400 text-gray-700 placeholder-gray-300 text-sm" %>
      <%= f.submit "Search",
            class: "px-5 py-2.5 bg-blue-500 hover:bg-blue-600 text-white rounded-xl font-semibold text-sm shadow-sm transition-colors cursor-pointer" %>
    <% end %>
  </div>

  <%# Weather Card %>
  <div class="w-full max-w-2xl bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">

    <%# Header: city + date/condition %>
    <div class="px-6 pt-6 pb-3">
      <h1 class="text-2xl font-bold text-gray-900">Truckee, CA</h1>
      <p class="text-gray-400 text-sm mt-0.5">Monday 10AM &bull; Sunny with a light wind.</p>
    </div>

    <%# Temperature + extra info %>
    <div class="px-6 py-4 flex items-start justify-between">
      <div class="flex items-center gap-3">
        <%# Sun icon %>
        <svg class="w-14 h-14 text-yellow-400 flex-shrink-0" viewBox="0 0 48 48" fill="currentColor">
          <circle cx="24" cy="24" r="10"/>
          <g stroke="currentColor" stroke-width="3" stroke-linecap="round">
            <line x1="24" y1="4"  x2="24" y2="10"/>
            <line x1="24" y1="38" x2="24" y2="44"/>
            <line x1="4"  y1="24" x2="10" y2="24"/>
            <line x1="38" y1="24" x2="44" y2="24"/>
            <line x1="9.37"  y1="9.37"  x2="13.61" y2="13.61"/>
            <line x1="34.39" y1="34.39" x2="38.63" y2="38.63"/>
            <line x1="38.63" y1="9.37"  x2="34.39" y2="13.61"/>
            <line x1="13.61" y1="34.39" x2="9.37"  y2="38.63"/>
          </g>
        </svg>

        <div class="flex items-start leading-none">
          <span class="text-7xl font-bold text-gray-900 tracking-tight">62</span>
          <div class="flex flex-col mt-2 ml-1">
            <span class="text-2xl text-gray-400 font-light">&deg;</span>
            <span class="text-xs text-gray-400 mt-1 font-medium">F / C</span>
          </div>
        </div>
      </div>

      <div class="text-sm text-gray-500 text-right space-y-1 pt-1">
        <p>Humidity: 30%</p>
        <p>Winds: 12 MPH SW</p>
        <a href="#" class="text-blue-600 font-semibold hover:text-blue-700">Show More</a>
      </div>
    </div>

    <%# Wavy temperature chart %>
    <div class="w-full bg-gray-50 overflow-hidden" style="height: 64px;">
      <svg viewBox="0 0 700 64" preserveAspectRatio="none" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <path d="M0,38 C60,20 120,48 180,28 C240,8 310,52 390,22 C470,-2 560,40 640,26 L700,24 L700,64 L0,64 Z"
              fill="#f3f4f6"/>
        <path d="M0,38 C60,20 120,48 180,28 C240,8 310,52 390,22 C470,-2 560,40 640,26 L700,24"
              fill="none" stroke="#d1d5db" stroke-width="1.5"/>
      </svg>
    </div>

    <%# Hourly temperatures %>
    <div class="grid grid-cols-7 border-b border-gray-100">
      <% [["62°", "10AM"], ["64°", "2PM"], ["66°", "6PM"], ["62°", "10PM"], ["60°", "2AM"], ["58°", "6AM"], ["60°", "10AM"]].each_with_index do |(temp, time), i| %>
        <div class="flex flex-col items-center py-3 <%= i == 0 ? 'border-b-2 border-gray-900' : '' %>">
          <span class="text-sm font-semibold text-gray-800"><%= temp %></span>
          <span class="text-xs text-gray-400 mt-0.5"><%= time %></span>
        </div>
      <% end %>
    </div>

    <%# 7-day forecast %>
    <div class="grid grid-cols-7 divide-x divide-gray-50">
      <%
        days = [
          { day: "Mon", icon: :storm,   high: "66°", low: "32°" },
          { day: "Tue", icon: :partial, high: "64°", low: "36°" },
          { day: "Wed", icon: :sunny,   high: "68°", low: "44°" },
          { day: "Thu", icon: :sunny,   high: "71°", low: "42°" },
          { day: "Fri", icon: :rain,    high: "42°", low: "31°" },
          { day: "Sat", icon: :foggy,   high: "48°", low: "28°" },
          { day: "Sun", icon: :sunny,   high: "57°", low: "29°" },
        ]
      %>
      <% days.each do |d| %>
        <div class="flex flex-col items-center py-5 gap-1">
          <span class="text-xs font-semibold text-gray-600"><%= d[:day] %></span>

          <div class="my-1 w-8 h-8 flex items-center justify-center">
            <% case d[:icon] %>
            <% when :sunny %>
              <svg class="w-7 h-7 text-yellow-400" viewBox="0 0 24 24" fill="currentColor">
                <circle cx="12" cy="12" r="5"/>
                <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                  <line x1="12" y1="2"  x2="12" y2="5"/>
                  <line x1="12" y1="19" x2="12" y2="22"/>
                  <line x1="2"  y1="12" x2="5"  y2="12"/>
                  <line x1="19" y1="12" x2="22" y2="12"/>
                  <line x1="4.93" y1="4.93" x2="7.05" y2="7.05"/>
                  <line x1="16.95" y1="16.95" x2="19.07" y2="19.07"/>
                  <line x1="19.07" y1="4.93" x2="16.95" y2="7.05"/>
                  <line x1="7.05" y1="16.95" x2="4.93" y2="19.07"/>
                </g>
              </svg>
            <% when :partial %>
              <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="10" cy="9" r="4" fill="#FBBF24"/>
                <g stroke="#FBBF24" stroke-width="1.5" stroke-linecap="round">
                  <line x1="10" y1="2"  x2="10" y2="4"/>
                  <line x1="3.5" y1="4.5" x2="5" y2="6"/>
                  <line x1="2" y1="9" x2="4" y2="9"/>
                </g>
                <rect x="6" y="13" width="14" height="7" rx="3.5" fill="#D1D5DB"/>
              </svg>
            <% when :storm %>
              <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 13a5 5 0 0 1 9.5-2H14a4 4 0 1 1 0 8H6a4 4 0 0 1-4-4 4 4 0 0 1 2-3.46" fill="#D1D5DB"/>
                <path d="M13 18l-2 4h3l-2 4" stroke="#FBBF24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            <% when :rain %>
              <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 13a5 5 0 0 1 9.5-2H14a4 4 0 1 1 0 8H6a4 4 0 0 1-2-7.46" fill="#D1D5DB"/>
                <g stroke="#60A5FA" stroke-width="1.5" stroke-linecap="round">
                  <line x1="8"  y1="19" x2="7"  y2="22"/>
                  <line x1="12" y1="19" x2="11" y2="22"/>
                  <line x1="16" y1="19" x2="15" y2="22"/>
                </g>
              </svg>
            <% when :foggy %>
              <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 10a5 5 0 0 1 9.5-2H13a4 4 0 1 1 0 8H5a4 4 0 0 1-2-7.46" fill="#D1D5DB"/>
                <g stroke="#9CA3AF" stroke-width="1.5" stroke-linecap="round">
                  <line x1="3"  y1="19" x2="17" y2="19"/>
                  <line x1="3"  y1="22" x2="14" y2="22"/>
                </g>
              </svg>
            <% end %>
          </div>

          <span class="text-sm font-bold text-gray-900"><%= d[:high] %></span>
          <span class="text-xs text-gray-400"><%= d[:low] %></span>
        </div>
      <% end %>
    </div>

  </div>
</div>
